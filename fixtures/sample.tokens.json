{
  "color": {
    "$type": "color",
    "base": {
      "blue-500": {
        "$value": { "colorSpace": "srgb", "components": [0.231, 0.51, 0.965], "hex": "#3b82f6" }
      },
      "slate-900": {
        "$value": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "hex": "#0f172a" }
      }
    },
    "brand": {
      "primary": {
        "$value": "{color.base.blue-500}",
        "$description": "Primary brand color, aliases blue-500"
      },
      "text": { "$value": "{color.base.slate-900}" }
    }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 24, "unit": "px" } }
  },
  "type": {
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": { "value": 1.5, "unit": "rem" },
        "fontWeight": 700,
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.2
      }
    }
  }
}
