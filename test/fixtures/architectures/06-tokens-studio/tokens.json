{
  "$themes": [{ "id": "light", "name": "Light", "selectedTokenSets": { "global": "enabled" } }],
  "$metadata": {
    "tokenSetOrder": ["global", "semantic"]
  },
  "global": {
    "color": {
      "$type": "color",
      "blue": {
        "$value": { "colorSpace": "srgb", "components": [0.231, 0.51, 0.965], "hex": "#3b82f6" }
      }
    }
  },
  "semantic": {
    "action": { "$type": "color", "$value": "{global.color.blue}" }
  }
}
