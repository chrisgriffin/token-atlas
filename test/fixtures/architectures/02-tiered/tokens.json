{
  "primitive": {
    "color": {
      "$type": "color",
      "blue-500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.231, 0.51, 0.965],
          "hex": "#3b82f6"
        }
      },
      "slate-50": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.973, 0.98, 0.988],
          "hex": "#f8fafc"
        }
      }
    },
    "space": {
      "$type": "dimension",
      "4": { "$value": { "value": 16, "unit": "px" } }
    }
  },
  "semantic": {
    "color": {
      "action": {
        "$value": "{primitive.color.blue-500}",
        "$description": "Interactive elements"
      },
      "surface": { "$value": "{primitive.color.slate-50}" }
    },
    "space": {
      "inset": { "$value": "{primitive.space.4}" }
    }
  },
  "component": {
    "button": {
      "background": { "$value": "{semantic.color.action}" },
      "padding": { "$value": "{semantic.space.inset}" }
    }
  }
}
