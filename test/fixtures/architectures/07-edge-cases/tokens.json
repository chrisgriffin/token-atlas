{
  "deep": {
    "$type": "color",
    "a": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "hex": "#000000"
      }
    },
    "b": { "$value": "{deep.a}" },
    "c": { "$value": "{deep.b}" },
    "d": { "$value": "{deep.c}" }
  },
  "cycle": {
    "$type": "number",
    "x": { "$value": "{cycle.y}" },
    "y": { "$value": "{cycle.x}" }
  },
  "dangling": {
    "$type": "number",
    "orphan": { "$value": "{does.not.exist}" }
  },
  "inherit": {
    "$type": "dimension",
    "nested": {
      "deeper": {
        "leaf": { "$value": { "value": 4, "unit": "px" } }
      }
    }
  },
  "composite": {
    "shadow": {
      "card": {
        "$type": "shadow",
        "$value": {
          "color": "{deep.a}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 2, "unit": "px" },
          "blur": { "value": 8, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      }
    }
  }
}
