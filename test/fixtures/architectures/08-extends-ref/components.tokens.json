{
  "button-danger": {
    "$extends": "{button}",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8, { "$ref": "#/color/blue/$value/components/0" }, 0.2]
      }
    }
  },
  "button-pill": {
    "$extends": "{button-danger}",
    "radius": {
      "$value": {
        "value": { "$ref": "#/button/radius/$value/value" },
        "unit": "rem"
      }
    }
  },
  "link": { "$ref": "#/button-danger/background/$value", "$type": "color" }
}
