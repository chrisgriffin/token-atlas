{
  "color": {
    "$type": "color",
    "base": {
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "slate-100": {
        "$value": { "colorSpace": "srgb", "components": [0.945, 0.961, 0.976], "hex": "#f1f5f9" }
      },
      "slate-800": {
        "$value": { "colorSpace": "srgb", "components": [0.118, 0.161, 0.231], "hex": "#1e293b" }
      },
      "slate-900": {
        "$value": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "hex": "#0f172a" }
      },
      "blue-400": {
        "$value": { "colorSpace": "srgb", "components": [0.376, 0.647, 0.98], "hex": "#60a5fa" }
      },
      "blue-600": {
        "$value": { "colorSpace": "srgb", "components": [0.145, 0.388, 0.922], "hex": "#2563eb" }
      },
      "p3-red": {
        "$value": { "colorSpace": "display-p3", "components": [1, 0, 0], "hex": "#ff0000" }
      }
    }
  }
}
