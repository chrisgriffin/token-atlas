{
  "primitive": {
    "color": {
      "$type": "color",
      "blue-500": {
        "$value": { "colorSpace": "srgb", "components": [0.231, 0.51, 0.965], "hex": "#3b82f6" }
      },
      "blue-600": {
        "$value": { "colorSpace": "srgb", "components": [0.145, 0.388, 0.922], "hex": "#2563eb" }
      },
      "slate-50": {
        "$value": { "colorSpace": "srgb", "components": [0.973, 0.98, 0.988], "hex": "#f8fafc" }
      },
      "slate-900": {
        "$value": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "hex": "#0f172a" }
      },
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } }
    },
    "space": {
      "$type": "dimension",
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } }
    }
  },
  "semantic": {
    "color": {
      "action": {
        "$value": "{primitive.color.blue-500}",
        "$description": "Default interactive color"
      },
      "action-hover": { "$value": "{primitive.color.blue-600}" },
      "surface": { "$value": "{primitive.color.slate-50}" },
      "text": { "$value": "{primitive.color.slate-900}" },
      "text-inverse": { "$value": "{primitive.color.white}" }
    },
    "space": {
      "inset": { "$value": "{primitive.space.4}" },
      "stack": { "$value": "{primitive.space.3}" }
    }
  },
  "component": {
    "button": {
      "background": {
        "$value": "{semantic.color.action}",
        "$description": "Three hops deep — hover me"
      },
      "background-hover": { "$value": "{semantic.color.action-hover}" },
      "text": { "$value": "{semantic.color.text-inverse}" },
      "padding-x": { "$value": "{semantic.space.inset}" },
      "padding-y": { "$value": "{semantic.space.stack}" }
    },
    "card": {
      "background": { "$value": "{semantic.color.surface}" },
      "padding": { "$value": "{semantic.space.inset}" }
    }
  }
}
