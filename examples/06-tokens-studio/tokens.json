{
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": { "global": "enabled", "semantic": "enabled" }
    }
  ],
  "$metadata": {
    "tokenSetOrder": ["global", "semantic"]
  },
  "global": {
    "color": {
      "$type": "color",
      "blue": {
        "$value": { "colorSpace": "srgb", "components": [0.231, 0.51, 0.965], "hex": "#3b82f6" }
      },
      "slate": {
        "$value": { "colorSpace": "srgb", "components": [0.059, 0.09, 0.165], "hex": "#0f172a" }
      }
    },
    "size": {
      "$type": "dimension",
      "base": { "$value": { "value": 16, "unit": "px" } }
    }
  },
  "semantic": {
    "$type": "color",
    "action": { "$value": "{global.color.blue}" },
    "text": { "$value": "{global.color.slate}" }
  }
}
