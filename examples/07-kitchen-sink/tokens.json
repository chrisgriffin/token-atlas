{
  "colors": {
    "$type": "color",
    "srgb": {
      "$value": { "colorSpace": "srgb", "components": [0.231, 0.51, 0.965], "hex": "#3b82f6" }
    },
    "p3": {
      "$value": { "colorSpace": "display-p3", "components": [0, 0.8, 0.4] },
      "$description": "Wide-gamut — hover shows it mapped to CSS formats"
    },
    "oklch": { "$value": { "colorSpace": "oklch", "components": [0.7, 0.15, 250] } },
    "translucent": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.4 },
      "$description": "Checkerboard swatch"
    },
    "legacy-hex": {
      "$value": "#22c55e",
      "$description": "Old-style hex string still works",
      "$deprecated": "Use colors.p3 instead"
    }
  },
  "dimensions": {
    "$type": "dimension",
    "px-based": { "$value": { "value": 24, "unit": "px" } },
    "rem-based": { "$value": { "value": 1.25, "unit": "rem" } }
  },
  "motion": {
    "duration-fast": { "$type": "duration", "$value": { "value": 150, "unit": "ms" } },
    "ease-standard": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
    "transition-panel": {
      "$type": "transition",
      "$value": {
        "duration": { "value": 300, "unit": "ms" },
        "delay": { "value": 0, "unit": "ms" },
        "timingFunction": [0.4, 0, 0.2, 1]
      }
    }
  },
  "text": {
    "family": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
    "weight-keyword": { "$type": "fontWeight", "$value": "semi-bold" },
    "weight-number": { "$type": "fontWeight", "$value": 600 },
    "scale-ratio": { "$type": "number", "$value": 1.25 },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": { "value": 2, "unit": "rem" },
        "fontWeight": 700,
        "letterSpacing": { "value": -0.5, "unit": "px" },
        "lineHeight": 1.2
      }
    }
  },
  "effects": {
    "shadow-card": {
      "$type": "shadow",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.0588, 0.0902, 0.1647],
            "alpha": 0.2,
            "hex": "#0f172a"
          },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.0588, 0.0902, 0.1647],
            "alpha": 0.102,
            "hex": "#0f172a"
          },
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 4, "unit": "px" },
          "blur": { "value": 12, "unit": "px" },
          "spread": { "value": -2, "unit": "px" }
        }
      ]
    },
    "border-input": {
      "$type": "border",
      "$value": {
        "color": { "colorSpace": "srgb", "components": [0.7961, 0.8353, 0.8824], "hex": "#cbd5e1" },
        "width": { "value": 1, "unit": "px" },
        "style": "solid"
      }
    },
    "gradient-hero": {
      "$type": "gradient",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.2314, 0.5098, 0.9647],
            "hex": "#3b82f6"
          },
          "position": 0
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.5451, 0.3608, 0.9647],
            "hex": "#8b5cf6"
          },
          "position": 1
        }
      ]
    },
    "stroke-focus": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          { "value": 4, "unit": "px" },
          { "value": 2, "unit": "px" }
        ],
        "lineCap": "round"
      }
    }
  },
  "aliases": {
    "one-hop": { "$type": "color", "$value": "{colors.srgb}" },
    "two-hop": { "$type": "color", "$value": "{aliases.one-hop}" },
    "untyped-inherits": {
      "$value": "{colors.oklch}",
      "$description": "No $type — inherits color from the referent"
    }
  },
  "broken": {
    "$type": "number",
    "dangling": { "$value": "{nope.not.here}", "$description": "Shows as an error in Problems" },
    "cycle-a": { "$value": "{broken.cycle-b}" },
    "cycle-b": { "$value": "{broken.cycle-a}" }
  },
  "untyped": {
    "no-type-anywhere": {
      "$value": "mystery",
      "$description": "No $type declared or inherited — warning in Problems"
    }
  }
}
