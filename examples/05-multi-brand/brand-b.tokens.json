{
  "primitive": {
    "$type": "color",
    "accent": {
      "$value": { "colorSpace": "srgb", "components": [0.937, 0.267, 0.267], "hex": "#ef4444" },
      "$description": "Brand B is red"
    },
    "accent-soft": {
      "$value": { "colorSpace": "srgb", "components": [0.996, 0.886, 0.886], "hex": "#fee2e2" }
    }
  },
  "brand": {
    "$type": "color",
    "primary": {
      "$value": "{primitive.accent}",
      "$description": "Resolves to THIS brand's accent, not brand A's"
    },
    "primary-soft": { "$value": "{primitive.accent-soft}" }
  }
}
