{
  "color": {
    "$type": "color",
    "blue-500": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.231, 0.51, 0.965],
        "hex": "#3b82f6"
      }
    },
    "red-500": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.937, 0.267, 0.267],
        "hex": "#ef4444"
      }
    },
    "green-500": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.133, 0.773, 0.369],
        "hex": "#22c55e"
      }
    },
    "overlay": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.059, 0.09, 0.165],
        "alpha": 0.6,
        "hex": "#0f172a"
      },
      "$description": "60% scrim — hover to see the checkerboard behind the swatch"
    }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 24, "unit": "px" } },
    "xl": { "$value": { "value": 2, "unit": "rem" } }
  },
  "font": {
    "size": {
      "$type": "dimension",
      "body": { "$value": { "value": 1, "unit": "rem" } },
      "heading": { "$value": { "value": 1.5, "unit": "rem" } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": { "value": 12, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  }
}
